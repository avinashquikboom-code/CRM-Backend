generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SystemRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum ShipmentStatus {
  DRAFT
  BOOKED
  IN_TRANSIT
  CUSTOMS_HOLD
  CLEARED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ==========================================
// CORE INFRASTRUCTURE
// ==========================================

model Company {
  id                 String   @id @default(uuid())
  code               String   @unique @db.VarChar(50)
  name               String   @db.VarChar(255)
  registrationNumber String?  @db.VarChar(100)
  domain             String?  @db.VarChar(255)
  logoUrl            String?  @db.Text
  subscriptionTier   String   @default("ENTERPRISE") @db.VarChar(50)
  maxEmployees       Int      @default(100)
  maxShipments       Int      @default(10000)
  status             String   @default("ACTIVE") @db.VarChar(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  branches                Branch[]
  departments             Department[]
  employees               Employee[]
  customers               Customer[]
  vendors                 Vendor[]
  shippingLines           ShippingLine[]
  airlines                Airline[]
  chas                    CHA[]
  warehouses              Warehouse[]
  transports              Transport[]
  inquiries               Inquiry[]
  pricings                Pricing[]
  quotations              Quotation[]
  jobs                    Job[]
  bookings                Booking[]
  shipments               Shipment[]
  containers              Container[]
  shipmentItems           ShipmentItem[]
  documents               Document[]
  shipmentEvents          ShipmentEvent[]
  customsClearances       CustomsClearance[]
  invoices                Invoice[]
  invoiceItems            InvoiceItem[]
  payments                Payment[]
  paymentTerms            PaymentTerm[]
  users                   User[]
  userSessions            UserSession[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreference[]
  settings                Settings[]
  reportTemplates         ReportTemplate[]
  dashboards              Dashboard[]

  @@map("companies")
}

model Branch {
  id             String    @id @default(uuid())
  companyId      String
  branchCode     String    @db.VarChar(50)
  name           String    @db.VarChar(255)
  branchType     String    @default("OPERATIONAL") @db.VarChar(50)
  address        String?   @db.Text
  city           String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  operatingHours String?   @db.VarChar(100)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees  Employee[]
  warehouses Warehouse[]
  transports Transport[]

  @@unique([companyId, branchCode])
  @@index([companyId])
  @@map("branches")
}

model Department {
  id             String    @id @default(uuid())
  companyId      String
  departmentCode String    @db.VarChar(50)
  name           String    @db.VarChar(255)
  departmentType String    @default("GENERAL") @db.VarChar(50)
  headId         String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, departmentCode])
  @@index([companyId])
  @@map("departments")
}

model Employee {
  id           String    @id @default(uuid())
  companyId    String
  branchId     String?
  departmentId String?
  employeeCode String    @db.VarChar(50)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  email        String    @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  designation  String?   @db.VarChar(100)
  reportingToId String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportingTo Employee?   @relation("EmployeeHierarchy", fields: [reportingToId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeHierarchy")
  user        User?

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@map("employees")
}

// ==========================================
// BUSINESS PARTNERS
// ==========================================

model Customer {
  id           String    @id @default(uuid())
  companyId    String
  customerCode String    @db.VarChar(50)
  companyName  String    @db.VarChar(255)
  email        String    @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  customerType String    @default("IMPORTER") @db.VarChar(50)
  creditLimit  Decimal?  @db.Decimal(18, 2)
  rating       String?   @db.VarChar(20)
  address      String?   @db.Text
  city         String?   @db.VarChar(100)
  country      String?   @db.VarChar(100)
  status       String    @default("ACTIVE") @db.VarChar(50)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inquiries  Inquiry[]
  quotations Quotation[]
  jobs       Job[]
  shipments  Shipment[]
  invoices   Invoice[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@map("customers")
}

model Vendor {
  id          String    @id @default(uuid())
  companyId   String
  vendorCode  String    @db.VarChar(50)
  companyName String    @db.VarChar(255)
  vendorType  String    @default("CARRIER") @db.VarChar(50)
  email       String    @db.VarChar(255)
  phone       String?   @db.VarChar(50)
  bankDetails String?   @db.Text
  status      String    @default("ACTIVE") @db.VarChar(50)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, vendorCode])
  @@index([companyId])
  @@map("vendors")
}

model ShippingLine {
  id                 String    @id @default(uuid())
  companyId          String
  lineCode           String    @db.VarChar(50)
  name               String    @db.VarChar(255)
  imoNumber          String?   @db.VarChar(50)
  averageTransitTime String?   @db.VarChar(100)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([companyId, lineCode])
  @@index([companyId])
  @@map("shipping_lines")
}

model Airline {
  id            String    @id @default(uuid())
  companyId     String
  airlineCode   String    @db.VarChar(50)
  name          String    @db.VarChar(255)
  iataCode      String?   @db.VarChar(10)
  cargoCapacity Decimal?  @db.Decimal(18, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([companyId, airlineCode])
  @@index([companyId])
  @@map("airlines")
}

model CHA {
  id                String    @id @default(uuid())
  companyId         String
  chaCode           String    @db.VarChar(50)
  name              String    @db.VarChar(255)
  licenseNumber     String    @db.VarChar(100)
  licenseExpiryDate DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customsClearances CustomsClearance[]

  @@unique([companyId, chaCode])
  @@index([companyId])
  @@map("chas")
}

// ==========================================
// LOGISTICS INFRASTRUCTURE
// ==========================================

model Warehouse {
  id            String    @id @default(uuid())
  companyId     String
  branchId      String?
  warehouseCode String    @db.VarChar(50)
  name          String    @db.VarChar(255)
  warehouseType String    @default("GENERAL") @db.VarChar(50)
  capacity      Decimal?  @db.Decimal(18, 2)
  address       String?   @db.Text
  city          String?   @db.VarChar(100)
  country       String?   @db.VarChar(100)
  facilities    String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([companyId, warehouseCode])
  @@index([companyId])
  @@map("warehouses")
}

model Transport {
  id            String    @id @default(uuid())
  companyId     String
  branchId      String?
  transportCode String    @db.VarChar(50)
  vehicleNumber String    @db.VarChar(50)
  vehicleType   String    @db.VarChar(50)
  capacity      Decimal?  @db.Decimal(18, 2)
  driverName    String?   @db.VarChar(100)
  driverPhone   String?   @db.VarChar(50)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([companyId, transportCode])
  @@index([companyId])
  @@map("transports")
}

// ==========================================
// TRANSACTION FLOW
// ==========================================

model Inquiry {
  id            String    @id @default(uuid())
  companyId     String
  customerId    String
  inquiryNumber String    @db.VarChar(50)
  inquiryType   String    @default("SEA") @db.VarChar(50)
  commodity     String    @db.VarChar(255)
  weight        Decimal?  @db.Decimal(18, 2)
  volume        Decimal?  @db.Decimal(18, 2)
  origin        String    @db.VarChar(100)
  destination   String    @db.VarChar(100)
  remarks       String?   @db.Text
  status        String    @default("PENDING") @db.VarChar(50)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotations Quotation[]

  @@unique([companyId, inquiryNumber])
  @@index([companyId])
  @@map("inquiries")
}

model Pricing {
  id             String    @id @default(uuid())
  companyId      String
  pricingCode    String    @db.VarChar(50)
  pricingType    String    @default("FREIGHT") @db.VarChar(50)
  basePrice      Decimal   @db.Decimal(18, 2)
  validFromDate  DateTime
  validUntilDate DateTime
  origin         String    @db.VarChar(100)
  destination    String    @db.VarChar(100)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pricingCode])
  @@index([companyId])
  @@map("pricings")
}

model Quotation {
  id              String    @id @default(uuid())
  companyId       String
  inquiryId       String?
  customerId      String
  quotationNumber String    @db.VarChar(50)
  baseFare        Decimal   @db.Decimal(18, 2)
  taxes           Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal   @db.Decimal(18, 2)
  validUntilDate  DateTime
  status          String    @default("DRAFT") @db.VarChar(50)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inquiry  Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  jobs     Job[]

  @@unique([companyId, quotationNumber])
  @@index([companyId])
  @@map("quotations")
}

model Job {
  id                    String    @id @default(uuid())
  companyId             String
  quotationId           String?
  customerId            String
  jobNumber             String    @db.VarChar(50)
  jobType               String    @default("IMPORT") @db.VarChar(50)
  estimatedDeliveryDate DateTime?
  profitMargin          Decimal?  @db.Decimal(18, 2)
  status                String    @default("ACTIVE") @db.VarChar(50)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookings  Booking[]
  shipments Shipment[]
  invoices  Invoice[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@map("jobs")
}

// ==========================================
// BOOKING & SHIPMENT MANAGEMENT
// ==========================================

model Booking {
  id              String    @id @default(uuid())
  companyId       String
  jobId           String?
  shippingLineId  String?
  airlineId       String?
  bookingNumber   String    @db.VarChar(50)
  vesselName      String?   @db.VarChar(100)
  flightNumber    String?   @db.VarChar(50)
  containerNumber String?   @db.VarChar(50)
  status          String    @default("CONFIRMED") @db.VarChar(50)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  shippingLine ShippingLine? @relation(fields: [shippingLineId], references: [id], onDelete: SetNull)
  airline      Airline?      @relation(fields: [airlineId], references: [id], onDelete: SetNull)
  shipments    Shipment[]

  @@unique([companyId, bookingNumber])
  @@index([companyId])
  @@map("bookings")
}

model Shipment {
  id                    String         @id @default(uuid())
  companyId             String
  customerId            String
  jobId                 String?
  bookingId             String?
  shipmentNumber        String         @db.VarChar(50)
  shipmentType          String         @default("FCL") @db.VarChar(50)
  origin                String         @db.VarChar(100)
  destination           String         @db.VarChar(100)
  totalWeight           Decimal?       @db.Decimal(18, 2)
  totalVolume           Decimal?       @db.Decimal(18, 2)
  totalValue            Decimal?       @db.Decimal(18, 2)
  estimatedDeliveryDate DateTime?
  status                ShipmentStatus @default(DRAFT)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job               Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  containers        Container[]
  shipmentItems     ShipmentItem[]
  documents         Document[]
  events            ShipmentEvent[]
  customsClearances CustomsClearance[]
  invoices          Invoice[]

  @@unique([companyId, shipmentNumber])
  @@index([companyId])
  @@index([status])
  @@map("shipments")
}

model Container {
  id              String    @id @default(uuid())
  companyId       String
  shipmentId      String
  containerNumber String    @db.VarChar(50)
  containerType   String    @default("40FT") @db.VarChar(50)
  sealNumber      String?   @db.VarChar(50)
  grossWeight     Decimal?  @db.Decimal(18, 2)
  volume          Decimal?  @db.Decimal(18, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentItems ShipmentItem[]

  @@index([companyId])
  @@index([shipmentId])
  @@map("containers")
}

model ShipmentItem {
  id              String    @id @default(uuid())
  companyId       String
  shipmentId      String
  containerId     String?
  itemDescription String    @db.Text
  hsCode          String?   @db.VarChar(50)
  quantity        Int       @default(1)
  weight          Decimal?  @db.Decimal(18, 2)
  volume          Decimal?  @db.Decimal(18, 2)
  declaredValue   Decimal?  @db.Decimal(18, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  container Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([shipmentId])
  @@map("shipment_items")
}

model Document {
  id             String    @id @default(uuid())
  companyId      String
  shipmentId     String?
  documentType   String    @db.VarChar(50)
  documentNumber String?   @db.VarChar(100)
  s3FileKey      String?   @db.Text
  fileUrl        String?   @db.Text
  status         String    @default("PENDING") @db.VarChar(50)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([shipmentId])
  @@map("documents")
}

model ShipmentEvent {
  id               String   @id @default(uuid())
  companyId        String
  shipmentId       String
  recordedById     String?
  eventType        String   @db.VarChar(50)
  eventDescription String   @db.Text
  eventDate        DateTime @default(now())
  location         String?  @db.VarChar(100)
  remarks          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([shipmentId])
  @@map("shipment_events")
}

model CustomsClearance {
  id                       String    @id @default(uuid())
  companyId                String
  shipmentId               String
  chaId                    String?
  customsDeclarationNumber String    @db.VarChar(100)
  dutiableValue            Decimal?  @db.Decimal(18, 2)
  duties                   Decimal?  @db.Decimal(18, 2)
  taxes                    Decimal?  @db.Decimal(18, 2)
  status                   String    @default("SUBMITTED") @db.VarChar(50)
  clearedAt                DateTime?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipment Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  cha      CHA?      @relation(fields: [chaId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([shipmentId])
  @@map("customs_clearances")
}

// ==========================================
// FINANCIAL MANAGEMENT
// ==========================================

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  customerId    String
  jobId         String?
  shipmentId    String?
  invoiceNumber String        @db.VarChar(50)
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime
  invoiceType   String        @default("FREIGHT") @db.VarChar(50)
  subtotal      Decimal       @db.Decimal(18, 2)
  tax           Decimal       @db.Decimal(18, 2)
  totalAmount   Decimal       @db.Decimal(18, 2)
  status        InvoiceStatus @default(DRAFT)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job      Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  shipment Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  companyId       String
  invoiceId       String
  itemDescription String   @db.Text
  quantity        Int      @default(1)
  rate            Decimal  @db.Decimal(18, 2)
  amount          Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String   @id @default(uuid())
  companyId       String
  invoiceId       String
  paymentNumber   String   @db.VarChar(50)
  amount          Decimal  @db.Decimal(18, 2)
  paymentMethod   String   @default("BANK_TRANSFER") @db.VarChar(50)
  paymentDate     DateTime @default(now())
  referenceNumber String?  @db.VarChar(100)
  status          String   @default("COMPLETED") @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([invoiceId])
  @@map("payments")
}

model PaymentTerm {
  id              String    @id @default(uuid())
  companyId       String
  termCode        String    @db.VarChar(50)
  name            String    @db.VarChar(100)
  days            Int       @default(30)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  discountDays    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, termCode])
  @@index([companyId])
  @@map("payment_terms")
}

// ==========================================
// SECURITY & ACCESS CONTROL
// ==========================================

model User {
  id           String     @id @default(uuid())
  companyId    String
  employeeId   String?    @unique
  email        String     @db.VarChar(255)
  username     String?    @db.VarChar(100)
  passwordHash String     @db.Text
  firstName    String     @db.VarChar(100)
  lastName     String     @db.VarChar(100)
  phone        String?    @db.VarChar(50)
  avatarUrl    String?    @db.Text
  role         SystemRole @default(STAFF)
  status       UserStatus @default(ACTIVE)
  mfaEnabled   Boolean    @default(false)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  tokens    RefreshToken[]
  sessions  UserSession[]
  userRoles UserRole[]
  auditLogs AuditLog[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  companyId    String
  userId       String
  sessionToken String   @unique @db.Text
  deviceId     String?  @db.VarChar(100)
  deviceType   String?  @db.VarChar(50)
  ipAddress    String?  @db.VarChar(50)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("user_sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id            String    @id @default(uuid())
  companyId     String
  roleCode      String    @db.VarChar(50)
  roleName      String    @db.VarChar(100)
  description   String?   @db.Text
  isSystem      Boolean   @default(false)
  permissionSet String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, roleCode])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid())
  companyId      String
  roleId         String
  permissionCode String   @db.VarChar(100)
  resource       String   @db.VarChar(100)
  action         String   @db.VarChar(50)
  scope          String?  @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole {
  id            String    @id @default(uuid())
  companyId     String
  userId        String
  roleId        String
  validFromDate DateTime?
  validToDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, roleId])
  @@index([companyId])
  @@index([userId])
  @@map("user_roles")
}

// ==========================================
// AUDIT & COMPLIANCE
// ==========================================

model AuditLog {
  id            String   @id @default(uuid())
  companyId     String
  userId        String?
  entityType    String   @db.VarChar(100)
  entityId      String   @db.VarChar(100)
  action        String   @db.VarChar(50)
  oldValues     String?  @db.Text
  newValues     String?  @db.Text
  changedFields String?  @db.Text
  ipAddress     String?  @db.VarChar(50)
  timestamp     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ==========================================
// NOTIFICATIONS & CONFIGURATION
// ==========================================

model NotificationPreference {
  id               String   @id @default(uuid())
  companyId        String
  userId           String?
  notificationType String   @db.VarChar(50)
  category         String   @db.VarChar(50)
  isEnabled        Boolean  @default(true)
  frequency        String   @default("IMMEDIATE") @db.VarChar(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("notification_preferences")
}

model Settings {
  id           String   @id @default(uuid())
  companyId    String
  settingKey   String   @db.VarChar(100)
  settingValue String   @db.Text
  settingType  String   @default("STRING") @db.VarChar(50)
  category     String   @default("GENERAL") @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, settingKey])
  @@index([companyId])
  @@map("settings")
}

// ==========================================
// ANALYTICS & REPORTING
// ==========================================

model ReportTemplate {
  id              String    @id @default(uuid())
  companyId       String
  reportName      String    @db.VarChar(255)
  reportType      String    @db.VarChar(50)
  queryDefinition String?   @db.Text
  schedule        String?   @db.VarChar(100)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("report_templates")
}

model Dashboard {
  id                  String    @id @default(uuid())
  companyId           String
  dashboardName       String    @db.VarChar(255)
  widgets             String?   @db.Text
  layout              String?   @db.Text
  autoRefreshInterval Int       @default(60)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("dashboards")
}
